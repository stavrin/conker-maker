  "events": [
    {
      "id": "meet",
      "name": "Meet Mrs. Bee",
      "cutscene": true,
      "when": {
        "type": "level_start"
      },
      "do": [
        {
          "type": "hide",
          "object": "armed_hive"
        },
        {
          "type": "camera",
          "camera": "cam_wide",
          "seconds": 0
        },
        {
          "type": "move",
          "object": "conker",
          "to": "meet",
          "seconds": 2.2
        },
        {
          "type": "face",
          "object": "conker",
          "target": "mrs_bee"
        },
        {
          "type": "face",
          "object": "mrs_bee",
          "target": "conker"
        },
        {
          "type": "camera",
          "camera": "cam_bee",
          "seconds": 0.8
        },
        {
          "type": "say",
          "speaker": "Mrs. Bee",
          "text": "Oh, it's terrible! Simply terrible!"
        },
        {
          "type": "say",
          "speaker": "Mrs. Bee",
          "text": "Some enormous wasps came and stole my hive!"
        },
        {
          "type": "camera",
          "camera": "cam_conker",
          "seconds": 0
        },
        {
          "type": "say",
          "speaker": "Conker",
          "text": "Wasps, eh? Nasty little buggers."
        },
        {
          "type": "camera",
          "camera": "cam_bee",
          "seconds": 0
        },
        {
          "type": "say",
          "speaker": "Mrs. Bee",
          "text": "They took it up the hill. Please, bring it back to me!"
        },
        {
          "type": "camera",
          "camera": "cam_hill",
          "seconds": 1.6
        },
        {
          "type": "wait",
          "seconds": 1.2
        },
        {
          "type": "say",
          "speaker": "Conker",
          "text": "Up there? Right. How hard can it be?"
        }
      ],
      "only_if": [
        {
          "type": "flag_not_set",
          "flag": "hive_returned"
        }
      ]
    },
    {
      "id": "grab",
      "name": "Grab the hive",
      "cutscene": true,
      "when": {
        "type": "pick_up",
        "object": "hive"
      },
      "do": [
        {
          "type": "camera",
          "camera": "cam_hill",
          "seconds": 0
        },
        {
          "type": "say",
          "speaker": "Conker",
          "text": "Got it!"
        },
        {
          "type": "set_flag",
          "flag": "hive_taken"
        },
        {
          "type": "animate",
          "object": "wasp_1",
          "animation": "attack"
        },
        {
          "type": "say",
          "speaker": "Wasp",
          "text": "Oi! That's ours! Get him, lads!"
        }
      ]
    },
    {
      "id": "return",
      "name": "Give the hive back",
      "cutscene": true,
      "when": {
        "type": "deliver",
        "object": "hive"
      },
      "do": [
        {
          "type": "camera",
          "camera": "cam_return",
          "seconds": 0.6
        },
        {
          "type": "face",
          "object": "mrs_bee",
          "target": "conker"
        },
        {
          "type": "say",
          "speaker": "Mrs. Bee",
          "text": "My hive! Oh, you darling squirrel!"
        },
        {
          "type": "say",
          "speaker": "Mrs. Bee",
          "text": "Now, stand back, dear."
        },
        {
          "type": "hide",
          "object": "hive"
        },
        {
          "type": "show",
          "object": "armed_hive"
        },
        {
          "type": "move",
          "object": "mrs_bee",
          "to": "armed_hive",
          "seconds": 0.8
        },
        {
          "type": "hide",
          "object": "mrs_bee"
        },
        {
          "type": "say",
          "speaker": "Mrs. Bee (in the hive)",
          "text": "Now, let's see how those wasps like THIS!"
        },
        {
          "type": "shoot",
          "object": "armed_hive",
          "target": "wasp_1"
        },
        {
          "type": "wait",
          "seconds": 0.3
        },
        {
          "type": "shoot",
          "object": "armed_hive",
          "target": "wasp_2"
        },
        {
          "type": "wait",
          "seconds": 0.3
        },
        {
          "type": "shoot",
          "object": "armed_hive",
          "target": "wasp_3"
        },
        {
          "type": "wait",
          "seconds": 0.8
        },
        {
          "type": "camera",
          "camera": "cam_return",
          "seconds": 0.6
        },
        {
          "type": "say",
          "speaker": "Mrs. Bee (in the hive)",
          "text": "There. Here's a little something for your trouble."
        },
        {
          "type": "set_flag",
          "flag": "hive_returned"
        },
        {
          "type": "wait",
          "seconds": 0.8
        },
        {
          "type": "say",
          "speaker": "Conker",
          "text": "Ooh! Don't mind if I do."
        }
      ]
    },
    {
      "id": "in_the_hive",
      "name": "Mrs. Bee stays in her hive",
      "when": {
        "type": "level_start"
      },
      "only_if": [
        {
          "type": "flag_set",
          "flag": "hive_returned"
        }
      ],
      "do": [
        {
          "type": "hide",
          "object": "mrs_bee"
        },
        {
          "type": "hide",
          "object": "hive"
        },
        {
          "type": "show",
          "object": "armed_hive"
        }
      ]
    }
  ]
}
