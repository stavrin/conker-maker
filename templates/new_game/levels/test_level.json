  "events": [
    {
      "id": "e1",
      "name": "Intro",
      "when": {
        "type": "level_start"
      },
      "do": [
        {
          "type": "say",
          "speaker": "Conker",
          "text": "Ugh. Not again. Where am I this time?"
        }
      ]
    },
    {
      "id": "e2",
      "name": "Barkeep chat",
      "when": {
        "type": "talk_to",
        "object": "barkeep"
      },
      "do": [
        {
          "type": "set_flag",
          "flag": "met_barkeep"
        }
      ]
    },
    {
      "id": "e6",
      "name": "Pay the barkeep",
      "when": {
        "type": "talk_to",
        "object": "barkeep"
      },
      "only_if": [
        {
          "type": "cash_at_least",
          "amount": 30
        },
        {
          "type": "flag_not_set",
          "flag": "paid_barkeep"
        }
      ],
      "do": [
        {
          "type": "say",
          "speaker": "Barkeep",
          "text": "Thirty bucks? Well, well. Hand it over."
        },
        {
          "type": "take_cash",
          "amount": 30
        },
        {
          "type": "set_flag",
          "flag": "paid_barkeep"
        },
        {
          "type": "say",
          "speaker": "Barkeep",
          "text": "Your memory? Last I saw, it staggered out that door, heading for the barn."
        },
        {
          "type": "say",
          "speaker": "Conker",
          "text": "Cheers. I think."
        }
      ]
    },
    {
      "id": "e7",
      "name": "Barkeep after paying",
      "when": {
        "type": "talk_to",
        "object": "barkeep"
      },
      "only_if": [
        {
          "type": "flag_set",
          "flag": "paid_barkeep"
        }
      ],
      "do": [
        {
          "type": "say",
          "speaker": "Barkeep",
          "text": "We're square. Now get out of my bar."
        }
      ]
    },
    {
      "id": "e3",
      "name": "B pad",
      "when": {
        "type": "press_pad",
        "object": "pad"
      },
      "do": [
        {
          "type": "say",
          "speaker": "Conker",
          "text": "Nope. Brain's still asleep."
        },
        {
          "type": "give_cash",
          "amount": 5
        }
      ]
    },
    {
      "id": "e4",
      "name": "All cash",
      "when": {
        "type": "all_cash"
      },
      "do": [
        {
          "type": "say",
          "speaker": "Conker",
          "text": "Thirty quid. That'll do."
        }
      ]
    },
    {
      "id": "e5",
      "name": "Near the door",
      "when": {
        "type": "enter_zone",
        "object": "door_zone"
      },
      "do": [
        {
          "type": "say",
          "speaker": "Conker",
          "text": "The barn... why does that ring a bell?"
        }
      ]
    }
  ]
}
